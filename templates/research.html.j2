{% extends "base.html.j2" %}
{% set page = 'research' %}
{% block title %}Research · {{ profile.name }}{% endblock %}
{% block content %}

<section class="page-header container">
  <div class="research-header">
    <div class="research-header-text">
      <h1 class="display">Publications &amp; Presentations</h1>
      <p class="lede">
        Peer-reviewed articles pulled live from ORCID; posters and other work added by hand.
      </p>
    </div>
    <div class="research-header-links">
      {% for s in profile.socials %}
        {% if s.name in ["ORCID", "ResearchGate", "Google Scholar"] %}
          <a class="profile-link-btn" href="{{ s.url }}" {{ s.url | new_tab }}>
            <span class="profile-link-icon">
              {% if s.logo %}
                <img src="{{ s.logo }}" alt="" />
              {% else %}
                {{ s.name[0] }}
              {% endif %}
            </span>
            <span class="profile-link-text">
              <span class="profile-link-name">{{ s.name }}</span>
              <span class="profile-link-sub">View profile →</span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% for group in pub_groups %}
<section class="section container">
  <h2 class="section-h">{{ group.heading }}</h2>
  <div class="rule-gold"></div>
  <ul class="pub-list">
    {% for p in group.pubs %}
      <li class="pub">
        <div class="pub-citation">
          <span class="pub-authors">{{ p.authors | citation_authors }}</span>
          <span class="pub-year">({{ p | year_month }}).</span>
          <span class="pub-title">{{ p.title }}.</span>
          {% if p.venue %}
            <span class="pub-venue">{{ p.venue }}.</span>
          {% endif %}
        </div>
        <div class="pub-meta">
          <span class="chip chip-type">{{ p.type.replace('-', ' ') | title }}</span>
          {% if p.award %}
            <span class="chip chip-award">{{ p.award }}</span>
          {% endif %}
          {% if p.note %}
            <span class="pub-note">{{ p.note }}</span>
          {% endif %}
        </div>
        {% set has_doi = p.doi %}
        {% set has_url = p.url %}
        {% set has_links = p.links %}
        {% if has_doi or has_url or has_links %}
          <ul class="link-row">
            {% if has_doi %}
              <li><a href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener noreferrer">DOI</a></li>
            {% elif has_url %}
              <li><a href="{{ p.url }}" {{ p.url | new_tab }}>Link</a></li>
            {% endif %}
            {% for label, url in (p.links or {}).items() %}
              <li><a href="{{ url }}" {{ url | new_tab }}>{{ label }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

{% endblock %}
