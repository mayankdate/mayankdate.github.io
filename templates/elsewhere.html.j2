{% extends "base.html.j2" %}
{% set page = 'elsewhere' %}
{% block title %}Elsewhere · {{ profile.name }}{% endblock %}
{% block content %}

<section class="elsewhere-wrap container">
  <div class="elsewhere-grid">

    <!-- The windowed play area -->
    <div class="elsewhere-frame-wrap">
      <iframe
        src="/Elsewhere/"
        title="Elsewhere — a cozy pixel cabin"
        loading="lazy"
        allow="autoplay; encrypted-media"
      ></iframe>
    </div>

    <!-- Instructions column (for the non-gamers) -->
    <aside class="elsewhere-guide">
      <h1 class="elsewhere-h">Elsewhere</h1>
      <p class="elsewhere-tag">The off-hours cut of me — a little cabin beyond the resume.</p>

      <h2 class="elsewhere-sub">How to play</h2>
      <ul class="elsewhere-keys">
        <li><span class="k"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span> <span>move around</span></li>
        <li><span class="k"><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd></span> <span>also move</span></li>
        <li><span class="k"><kbd>E</kbd> / <kbd>Space</kbd></span> <span>talk, and interact when close</span></li>
        <li><span class="k"><kbd>+</kbd> <kbd>−</kbd> / scroll</span> <span>zoom in &amp; out</span></li>
      </ul>
      <ul class="elsewhere-touch">
        <li><span class="k">Drag (left)</span> <span>a joystick appears — steer to move</span></li>
        <li><span class="k">Tap <b>E</b></span> <span>talk, and interact when close</span></li>
        <li><span class="k">Tap <b>+ −</b></span> <span>zoom in &amp; out</span></li>
      </ul>

      <h2 class="elsewhere-sub">What's here</h2>
      <ul class="elsewhere-legend">
        <li><b>Books</b> — what I'm reading</li>
        <li><b>Music</b> — playlists on repeat</li>
        <li><b>Games</b> — the ones that stuck</li>
        <li><b>Art</b> — things I've painted</li>
        <li><b>Coffee, fireplace, sushi</b> — the rest of the cabin</li>
      </ul>

      <p class="elsewhere-note">
        Walk up to anything and a <kbd>E</kbd> prompt appears — press it to look closer.
      </p>
    </aside>

  </div>
</section>

{% endblock %}

{% block page_scripts %}
<style>
  .elsewhere-wrap { padding-top: 20px; padding-bottom: 40px; }

  .elsewhere-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 24px;
    align-items: stretch;
  }

  .elsewhere-frame-wrap {
    position: relative;
    border: 1px solid var(--border, rgba(13,37,69,0.25));
    border-radius: 8px;
    overflow: hidden;
    background: #b299b4;
    box-shadow: 0 14px 40px rgba(0,0,0,0.18);
    min-height: 600px;
  }
  .elsewhere-frame-wrap iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0;
  }

  .elsewhere-guide {
    align-self: start;
    border: 1px solid var(--border, rgba(13,37,69,0.14));
    border-radius: 8px;
    padding: 22px 22px 24px;
    background: var(--surface, rgba(13,37,69,0.03));
  }
  .elsewhere-h {
    font-family: Fraunces, Georgia, serif;
    font-size: 30px; margin: 0 0 6px;
    color: var(--text, #0D2545);
  }
  .elsewhere-tag {
    font-size: 14px; color: var(--muted, #3a4a63);
    margin: 0 0 20px; line-height: 1.5;
  }
  .elsewhere-sub {
    font-family: JetBrains Mono, monospace;
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--gold, #B8893E);
    margin: 18px 0 10px; padding-bottom: 6px;
    border-bottom: 1px solid var(--border, rgba(13,37,69,0.12));
  }
  .elsewhere-keys { list-style: none; margin: 0; padding: 0; }
  .elsewhere-keys li {
    display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--muted, #3a4a63);
    margin-bottom: 9px;
  }
  .elsewhere-keys .k { min-width: 108px; color: var(--text, #0D2545); }
  .elsewhere-keys kbd {
    display: inline-block; min-width: 18px; text-align: center;
    border: 1px solid var(--border, rgba(13,37,69,0.3));
    border-radius: 3px; padding: 1px 4px; margin-right: 2px;
    font-family: JetBrains Mono, monospace; font-size: 11px;
    background: var(--bg, #fff);
  }
  .elsewhere-legend { list-style: none; margin: 0; padding: 0; }
  .elsewhere-legend li {
    font-size: 13px; color: var(--muted, #3a4a63); margin-bottom: 7px;
  }
  .elsewhere-legend b { color: var(--text, #0D2545); }
  .elsewhere-note {
    font-size: 12px; color: var(--muted, #3a4a63);
    margin: 18px 0 0; line-height: 1.5;
  }
  .elsewhere-note kbd {
    border: 1px solid var(--border, rgba(13,37,69,0.3));
    border-radius: 3px; padding: 0 5px;
    font-family: JetBrains Mono, monospace; font-size: 11px;
    background: var(--bg, #fff);
  }

  .elsewhere-touch { list-style: none; margin: 0; padding: 0; display: none; }
  .elsewhere-touch li {
    display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--muted, #3a4a63); margin-bottom: 9px;
  }
  .elsewhere-touch .k { min-width: 108px; color: var(--text, #0D2545); font-weight: 600; }

  @media (max-width: 820px) {
    .elsewhere-grid { grid-template-columns: 1fr; }
    .elsewhere-frame-wrap { min-height: 76vh; min-height: 76dvh; }
  }
  /* touch devices: show the touch controls, hide the keyboard list */
  @media (pointer: coarse) {
    .elsewhere-keys { display: none; }
    .elsewhere-touch { display: block; }
  }

  .site-footer { display: none; }
</style>
{% endblock %}
