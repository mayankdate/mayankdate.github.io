{% extends "base.html.j2" %}
{% set page = 'elsewhere' %}
{% block title %}Elsewhere · {{ profile.name }}{% endblock %}
{% block content %}

<section class="hero container" style="padding-bottom: 8px;">
  <div class="hero-text" style="width: 100%;">
    <p class="eyebrow">Beyond the resume</p>
    <h1 class="display">Elsewhere</h1>
    <p class="lede">
      A quiet pixel room. The off-hours cut of me — books, music,
      games, art, the cat. Spirit transfer only.
    </p>
  </div>
</section>

<div class="elsewhere-stage">
  <div class="elsewhere-frame-wrap">
    <iframe
      src="/Elsewhere/"
      title="Elsewhere — a cozy pixel room"
      loading="lazy"
      allow="autoplay"
    ></iframe>
  </div>
  <p class="elsewhere-caption">
    Drag with your cursor to drift. Click shelves, cats, or me.
  </p>
</div>

{% endblock %}

{% block page_scripts %}
<style>
  .elsewhere-stage {
    max-width: 1180px;
    margin: 8px auto 48px;
    padding: 0 24px;
  }
  .elsewhere-frame-wrap {
    position: relative;
    border: 1px solid var(--border, rgba(13, 37, 69, 0.2));
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.18);
    background: #0D2545;
  }
  .elsewhere-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 70vh;
    min-height: 540px;
    border: 0;
  }
  .elsewhere-caption {
    font-family: JetBrains Mono, monospace;
    font-size: 12px;
    color: var(--muted, #3a4a63);
    margin-top: 10px;
    text-align: center;
  }
</style>
{% endblock %}
